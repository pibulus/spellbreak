<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build only (build-mas.sh). Xcode signs these two identity
         entitlements in automatically; a hand-rolled build has to state them, or
         App Store Connect flags the upload (ITMS-90886) because the provisioning
         profile names an app ID the signature doesn't carry. -->
    <key>com.apple.application-identifier</key>
    <string>V433H655PN.com.pabloalvarado.spellbreak</string>
    <key>com.apple.developer.team-identifier</key>
    <string>V433H655PN</string>

    <!-- App Sandbox is required for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
